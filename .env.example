# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# Never expose this key in Vite/browser code.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted (optional).
APP_URL=

# Supabase — browser-safe publishable credentials only
# Get these from Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional server-side aliases (same URL/key, or use service role for admin jobs)
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
